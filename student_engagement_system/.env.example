# ==============================================================
# Environment variables -- copy this file to .env and fill in real values.
# .env must NEVER be committed to version control.
# ==============================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Database ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=student_engagement_db

# --- Security ---
SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS (production only; leave unset for local dev) ---
# Comma-separated list of extra allowed frontend origins (e.g. the
# deployed Vercel URL), added on top of the always-on localhost regex
# in backend/app/main.py.
FRONTEND_ORIGIN=

# --- Camera / monitoring defaults ---
CAMERA_INDEX=0
FRAME_WIDTH=640
FRAME_HEIGHT=480

# --- AI component source selection (see backend/services/friend_ai/loader.py) ---
# Each independently selects "current" (this project's own, pre-integration
# implementation) or "friend" (the integrated MODEL_INTEGRATION_PACKAGE
# components). All three default to "friend" if unset. Read directly via
# os.environ by ai_service.py -- set these in your actual shell/.env before
# starting uvicorn, not just here.
AI_OBJECT_DETECTION_MODEL=friend
AI_LOOKING_AWAY_DROWSINESS_SOURCE=friend
AI_EMOTION_MODEL_SOURCE=friend
