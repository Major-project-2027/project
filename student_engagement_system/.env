# ==============================================================
# Environment variables -- copy this file to .env and fill in real values.
# .env must NEVER be committed to version control.
# ==============================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Database ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=student_engagement_db

# --- Security ---
SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Camera / monitoring defaults ---
CAMERA_INDEX=0
FRAME_WIDTH=640
FRAME_HEIGHT=480
