# Copy this file to frontend/.env (local dev) or set these in the
# Vercel project's Environment Variables (production) -- see
# src/services/api/client.ts, the single seam that reads them.
# Every var here MUST be prefixed VITE_ or Vite will not expose it to
# the browser bundle. None of these are secrets (they're just URLs the
# browser needs to know), so it's safe for them to end up client-side.

# FastAPI base URL (AI/live-monitoring, WebRTC signaling, LSTM predictions).
VITE_API_BASE_URL=http://127.0.0.1:8000

# Flask base URL (auth, classes, students, teachers, sessions, reports).
VITE_FLASK_API_BASE_URL=http://127.0.0.1:5000

# --- Optional: TURN server for WebRTC (see getIceServers() in client.ts) ---
# Public STUN alone (the always-on default) frequently cannot establish
# a peer connection once teacher and student are on different real-world
# networks (symmetric NAT/CGNAT/some corporate firewalls). Set all three
# of these to enable a TURN relay as a fallback; leave all three unset to
# keep today's STUN-only behavior unchanged.
# VITE_TURN_URL=turn:your-turn-provider.example.com:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
