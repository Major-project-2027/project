# ==========================================
# Copy this file to backend/.env and fill in real values.
# backend/.env must NEVER be committed (see repo .gitignore).
# ==========================================

# ==========================================
# Flask
# ==========================================
SECRET_KEY=change-this-in-production

# Comma-separated allowed origins for CORS, or "*" (default) to allow
# any origin -- e.g. the deployed Vercel URL in production.
CORS_ORIGINS=*

# The separate FastAPI process's base URL (see backend/app/main.py).
# Default is correct for local dev where both run on 127.0.0.1; in
# production (Render) set this to the FastAPI service's own URL.
FASTAPI_INTERNAL_URL=http://127.0.0.1:8000

# ==========================================
# Database (SQLite -- the application's live database)
# ==========================================
DATABASE_NAME=student_engagement.db

# ==========================================
# MongoDB (migration target -- see database/mongo.py)
# ==========================================
# "sqlite" (default, safe rollback) or "mongodb" -- the single toggle
# that controls which database the application actually reads/writes.
DB_BACKEND=sqlite
# MONGODB_URI style Atlas connection string, e.g.:
#   mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# A local MongoDB works identically for testing, e.g.:
#   mongodb://localhost:27017
MONGO_URI=
MONGO_DB_NAME=student_engagement_db

# ==========================================
# Project Root
# ==========================================
PROJECT_ROOT=..

# ==========================================
# AI Engine
# ==========================================
AI_ENGINE_PATH=../app.py

# ==========================================
# Models
# ==========================================
FACE_MODEL=../models/face_recognition_model.keras
EMOTION_MODEL=../models/emotion_recognition/emotion_model.keras
LANDMARK_MODEL=../face_landmarker.task
YOLO_MODEL=yolov8n.pt

# ==========================================
# Logs
# ==========================================
LOG_FOLDER=../logs

# ==========================================
# Reports
# ==========================================
REPORT_FOLDER=../reports

# ==========================================
# Uploads
# ==========================================
UPLOAD_FOLDER=../uploads
